# Copy this file to .env. Never commit .env.
ANTHROPIC_API_KEY=
FAST_MODEL=claude-haiku-5-5
MAIN_MODEL=claude-sonnet-5-5
# Set this to false to use live agents when an API key is present.
DEMO_MODE=true
# Labels and concept plans stay off until the adversarial suite passes. Even then, they need complete evidence, a finished review, verified rules and no exceeded limit.
SHOW_LABELS_AND_PLANS=false
# Turns on background reading. Use a shared team address, because it is sent to Open Library to identify the app.
OPEN_LIBRARY_CONTACT=
# Email stays in dry-run mode until you create the app address and set these.
EMAIL_ENABLED=false
EMAIL_ALLOWLIST=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Roadmap demonstrations (fictional company, illustrative structures). Keep off for the city demo.
SHOW_ROADMAP_DEMOS=false
